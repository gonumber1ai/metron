# ---------------------------------------------------------------- Fapshi (MoMo)
# From the Fapshi dashboard: Services -> METRON -> API tab.
# Each service has its own pair. Sandbox and live are DIFFERENT credentials.
FAPSHI_API_USER=
FAPSHI_API_KEY=

# https://live.fapshi.com  |  https://sandbox.fapshi.com
#
# You do NOT need a verified account to use sandbox, and no real money moves.
# Create a sandbox service in the dashboard — it has its OWN apiuser/apikey,
# separate from live. Point this at sandbox and use the test numbers below.
#
#   MTN success     670000000 · 670000002 · 650000000
#   Orange success  690000000 · 690000002 · 656000000
#   MTN failure     670000001 · 670000003 · 650000001
#   Orange failure  690000001 · 690000003 · 656000001
#
# Anything outside that list returns a RANDOM outcome, so always use these
# when you are testing — otherwise a "bug" may just be a coin flip.
FAPSHI_BASE_URL=https://sandbox.fapshi.com


# You invent this one. Paste the SAME value into the dashboard's
# "Configure Live Webhook" -> Webhook Secret field. Fapshi returns it on every
# call as the x-wh-secret header and we compare it here.
# Leave blank to skip the check (the payment-status re-verify still protects you).
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Direct Pay charges the handset straight from our own form — no redirect.
# It is OFF by default because Fapshi gate it behind an emailed application
# (see content/fapshi-direct-pay-application.md) and approve it only for cases
# where it is genuinely necessary. Until then the hosted checkout link is used,
# which works today. Set to 1 the day they approve you, and redeploy.
FAPSHI_DIRECT_PAY=

FAPSHI_WEBHOOK_SECRET=

# ------------------------------------------------------------------ Whop (card)
# International cards, USD. Whop is merchant of record — it sells on your
# behalf, handles tax, and pays out where Stripe will not onboard you.
# Bonus: the buyer's statement shows Whop's descriptor, not this brand.
#
# ONE bare product, no price on it. Every purchase creates a fresh checkout
# configuration with the price set per request, so the price book in
# lib/payments/index.ts stays the only place a number lives.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=biz_cIxLfHO4aVwm2P
WHOP_PRODUCT_ID=prod_d51N80zAmLRts

# Whop -> Developer -> Webhooks. You generate this; Whop signs each request
# body with it. Endpoint: https://metron.life/api/webhooks/whop
WHOP_WEBHOOK_SECRET=

# ⚠ THE 100x BUG. Our price book holds minor units ($15.00 = 1500). Whop's
# initial_price is conventionally a decimal major unit (15.00). We convert.
# RUN ONE REAL CHECKOUT AND CHECK THE AMOUNT SHOWN before you launch.
# If it is 100x wrong, set this to 1 and we send cents instead.
WHOP_PRICE_IN_MINOR_UNITS=

# Override if Whop moves the checkout configurations endpoint.
WHOP_CHECKOUT_ENDPOINT=

# Fallback only: a pre-priced plan id, used if the dynamic call fails.
WHOP_PLAN_ID=

# ------------------------------------------------------------------- database
# Supabase. Run supabase/schema.sql in the SQL editor first.
#
# Without these the app still works — payments, leads and recovery all fall
# back to asking the payment providers directly. What you lose is the man whose
# phone dies between paying and being redirected: the webhook knows he paid but
# has nowhere to write it, and he has to message you to get in.
NEXT_PUBLIC_SUPABASE_URL=https://atdikmbhshkovipureld.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row-level security entirely — server only, never in a
# NEXT_PUBLIC_ variable, never in the browser.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------- email
# Resend. Verify the metron.life domain in Resend first (it gives you SPF and
# DKIM DNS records) — sending from an unverified domain lands in spam.
RESEND_API_KEY=

# Sender. The display name is "Metron" and NOTHING more descriptive: it shows
# on his lock screen next to the subject line.
EMAIL_FROM=Metron <noreply@metron.life>

# Optional. Leave blank for a true no-reply. If you set it, put a real inbox
# there — an address that bounces is worse than none.
EMAIL_REPLY_TO=

# ----------------------------------------------------------------- entitlement
# Signs the proof-of-purchase cookie. Must be 32+ chars and must NOT change,
# or every existing customer is logged out of their programme.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENTITLEMENT_SECRET=

# ------------------------------------------------------------------------ app
# Used to build the Fapshi redirectUrl. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------- local dev only
# Walk the paid app without paying. NEVER set this in production.
METRON_DEV_UNLOCK=
